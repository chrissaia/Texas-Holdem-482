# Local development only. Copy to .env; never commit .env.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=rivr
POSTGRES_USER=rivr
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Host processes connect to Docker via 5433. Containers use db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
